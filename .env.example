# Public site URL (no trailing slash). Used for sitemap, canonical, Open Graph.
# Production example: https://hear-it.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth > URL Configuration must include {origin}/auth/callback
# e.g. http://localhost:3000/auth/callback
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
